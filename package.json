{
  "name": "pocket-axi",
  "version": "0.1.0",
  "description": "AXI-standard CLI and SDK for Pocket AI (heypocketai.com) meeting recordings, transcripts, summaries, and agent ingestion",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pocket-axi": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/cli.ts --outfile ./dist/cli.js --target node && bun build ./src/index.ts --outfile ./dist/index.js --target node && chmod +x ./dist/cli.js",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RooseveltAdvisors/pocket-axi.git"
  },
  "homepage": "https://github.com/RooseveltAdvisors/pocket-axi#readme",
  "bugs": {
    "url": "https://github.com/RooseveltAdvisors/pocket-axi/issues"
  },
  "keywords": [
    "pocket",
    "heypocketai",
    "transcription",
    "meeting-recorder",
    "cli",
    "agent",
    "axi",
    "obsidian",
    "second-brain"
  ],
  "author": "Roosevelt Advisors LLC",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
